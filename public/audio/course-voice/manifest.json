      "file": "4f4f5d279b94900f.wav",
      "duration": 2.40275,
      "bytes": 76934
    },
    {
      "id": "816b46c204a13e79",
      "text": "八秒後，回到墊上休息。",
      "file": "816b46c204a13e79.wav",
      "duration": 2.88175,
      "bytes": 92262
    },
    {
      "id": "76e2d27ed3fe7592",
      "text": "回到墊上休息。放慢動作，調整呼吸。",
      "file": "76e2d27ed3fe7592.wav",
      "duration": 4.631375,
      "bytes": 148250
    },
    {
      "id": "b6094fbe0a1a726a",
      "text": "預覽到這裡結束。",
